{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "leRoi",
  "mainBinaryName": "leroi",
  "version": "0.1.0",
  "identifier": "app.leroi.desktop",
  "build": {
    "beforeDevCommand": "pnpm start-vite",
    "beforeBuildCommand": "pnpm build-vite",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "leRoi",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "BoardGame",
    "targets": "all"
  }
}
